# Gemini · Google Cloud (Vertex AI) — bu dosyayı .env olarak kopyalayın (hepsi isteğe bağlı).
# Kimlik bilgisi tarayıcıya gönderilmez; yalnızca Vite geliştirme sunucusu ve server/index.js okur.

# Hizmet hesabı anahtarı (varsayılan: proje kökündeki key.json — .gitignore'da)
# GOOGLE_APPLICATION_CREDENTIALS=./key.json

# Proje kimliği (varsayılan: key.json içindeki project_id)
# GOOGLE_CLOUD_PROJECT=

# Uç nokta konumu — Gemini 3.x modelleri "global" uç noktadadır
GOOGLE_CLOUD_LOCATION=global

# Model ve yedekler (ilk model bulunamazsa sıradakine geçilir)
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-2.5-flash

# Düşünme seviyesi (Gemini 3.x): minimal | low | medium | high
GEMINI_THINKING=low

# Hız sınırı (istemci başına dakikada / günlük toplam)
AI_RATE_PER_MIN=40
AI_RATE_PER_DAY=3000
