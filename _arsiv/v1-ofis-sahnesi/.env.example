# ─────────────────────────────────────────────────────────────
# KKM — Ortam değişkenleri
# Bu dosyayı ".env.local" olarak kopyalayıp değerleri düzenleyin.
# ─────────────────────────────────────────────────────────────

# true  → Uygulama src/data/mockData.js üzerinden çalışır (varsayılan)
# false → İstekler VITE_API_BASE_URL adresindeki gerçek backend'e gider
VITE_USE_MOCK=true

# Backend hazır olduğunda kullanılacak REST API kök adresi
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Canlı güncellemeler için WebSocket adresi (yalnızca VITE_USE_MOCK=false iken)
VITE_WS_URL=ws://localhost:8080/live

# Mock modda ağ gecikmesi simülasyonu (milisaniye)
VITE_MOCK_LATENCY_MS=600
